{
  "$schema": "./node_modules/wrangler/config-schema.json",
	"name": "realm-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-15",
	"compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
	"vars": {
		"NODE_ENV": "production",
		"BREVO_API_KEY": ""
	},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "realm-db",
      "database_id": "FILL_FROM_ALCHEMY"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "FILL_FROM_ALCHEMY"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "realm-storage"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "realm-queue",
        "binding": "QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "realm-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "api.ahargunyllib.dev",
      "custom_domain": true
    }
  ]
}
