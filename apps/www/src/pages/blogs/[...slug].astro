---
import Footer from "@/components/footer.astro";
import Layout from "@/components/layout.astro";
import Section from "@/components/section.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((blogEntry) => ({
    params: { slug: blogEntry.id },
    props: { entry: blogEntry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} - Nugraha Billy Viandy`}
  description={entry.data.excerpt}
  canonical={`https://ahargunyllib.dev/blogs/${entry.id}`}
>
  <Section>
    <nav class="back-nav">
      <a href="/blogs" class="back-link">← Back to Blogs</a>
    </nav>

    <article class="blog-post">
      <header class="post-header">
        <h1>{entry.data.title}</h1>
        <div class="post-meta">
          <time class="text-tertiary mono">
            {new Date(entry.data.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
          </time>
          <div class="post-tags mono text-tertiary">
            {entry.data.tags.join(" · ")}
          </div>
        </div>
      </header>

      <div class="prose">
        <Content/>
      </div>
    </article>
  </Section>

  <Footer/>
</Layout>

<style>
  .back-nav {
    margin-bottom: var(--space-6);
  }

  .back-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .post-header {
    margin-bottom: var(--space-8);
  }

  .post-header h1 {
    margin-bottom: var(--space-3);
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .post-meta time {
    font-size: var(--text-small);
  }

  .post-tags {
    font-size: var(--text-small);
  }
</style>
