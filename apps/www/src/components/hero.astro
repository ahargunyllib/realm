---

<section class="hero">
  <h1 class="hero-name">{profile.name}</h1>
  <p class="hero-role text-secondary">{profile.role}</p>
  <p class="hero-bio" set:html={profile.bio}></p>
  <p class="hero-location text-tertiary text-small">{profile.location}</p>

  <div class="hero-social">
    <a
      href={`mailto:${profile.email}`}
      class="social-icon"
      title="Email"
      aria-label="Email"
    >
      <svg
        viewBox="0 0 24 24"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
        ></path>
      </svg>
    </a>
    {socialLinks.map((link) => (
        <a
          href={link.url}
          class="social-icon"
          title={link.platform}
          aria-label={link.platform}
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d={platformIcons[link.platform]} />
          </svg>
        </a>
      ))}
  </div>
</section>

<style>
  .hero {
    margin-bottom: var(--section-spacing);
  }

  .hero-name {
    font-size: var(--text-display);
    margin-bottom: var(--space-2);
  }

  .hero-role {
    font-size: var(--text-h2);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }

  .hero-bio {
    margin-bottom: var(--space-2);
    text-wrap-style: pretty;
  }

  .hero-location {
    margin-bottom: var(--space-3);
  }

  .hero-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: var(--color-text-secondary);
    border-bottom: none;
    transition: color 0.15s ease;
  }

  .social-icon:hover {
    color: var(--color-text-primary);
    opacity: 1;
  }

  .social-icon svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 640px) {
    .hero-name {
      font-size: 36px;
    }
  }
</style>
