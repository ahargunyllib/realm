---
import { getCollection } from "astro:content";
import Footer from "@/components/footer.astro";
import Layout from "@/components/layout.astro";
import Section from "@/components/section.astro";

const blogEntries = await getCollection("blog");
const sortedPosts = blogEntries.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout
  title="Blogs - Nugraha Billy Viandy"
  description="Technical writing about security, development, and competitive programming."
  canonical="https://ahargunyllib.dev/blogs"
>
  <Section>
    <h1>Blogs</h1>
    <p class="text-secondary" style="margin-bottom: 48px;">
      Technical writing about security, development, and competitive
      programming.
    </p>

    {sortedPosts.length === 0 ? (
        <div class="empty-state">
          <p class="text-secondary">No blog posts yet. Check back soon.</p>
        </div>
      ) : (
        <div class="posts-list">
          {sortedPosts.map((entry) => (
            <article class="post-item">
              <a
                href={`/blogs/${entry.slug}`}
                data-umami-event="content-click"
                data-umami-event-type="blog"
                data-umami-event-title={entry.data.title}
                data-umami-event-tags={entry.data.tags.join(" · ")}
                data-umami-event-location="list"
              >
                <h2>{entry.data.title}</h2>
              </a>
              <p class="post-date text-tertiary text-small">
                {new Date(entry.data.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <p class="post-excerpt text-secondary">{entry.data.excerpt}</p>
              <div class="post-tags mono text-tertiary">
                {entry.data.tags.join(" · ")}
              </div>
            </article>
          ))}
        </div>
      )}
  </Section>

  <Footer />
</Layout>

<style>
  .empty-state {
    padding: var(--space-3) 0;
    text-align: center;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .post-item {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-item h2 {
    margin-bottom: var(--space-1);
  }

  .post-date {
    margin-bottom: var(--space-2);
  }

  .post-excerpt {
    margin-bottom: var(--space-2);
    line-height: var(--leading-relaxed);
  }

  .post-tags {
    font-size: var(--text-small);
  }
</style>
