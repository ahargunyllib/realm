---
import Footer from "@/components/footer.astro";
import Layout from "@/components/layout.astro";
import Section from "@/components/section.astro";
---

<Layout
  title="Status - Nugraha Billy Viandy"
  description="Current status and availability."
  canonical="https://ahargunyllib.dev/status"
>
  <Section>
    <h1>Status</h1>
    <p class="text-secondary" style="margin-bottom: 48px;">
      Current status and availability.
    </p>

    <div class="status-grid">
      <div class="status-item">
        <div class="status-indicator status-active"></div>
        <div>
          <p class="status-label">Site Status</p>
          <p class="status-value text-secondary">Operational</p>
        </div>
      </div>

      <div class="status-item">
        <div class="status-indicator status-active"></div>
        <div>
          <p class="status-label">Availability</p>
          <p class="status-value text-secondary">Open to opportunities</p>
        </div>
      </div>

      <div class="status-item">
        <div class="status-indicator status-active"></div>
        <div>
          <p class="status-label">Last Updated</p>
          <p class="status-value text-secondary">
            {
              new Date().toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </p>
        </div>
      </div>
    </div>
  </Section>

  <Footer/>
</Layout>

<style>
  .status-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .status-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
  }

  .status-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-top: 4px;
    flex-shrink: 0;
  }

  .status-active {
    background-color: var(--color-text-secondary);
  }

  .status-label {
    font-weight: 500;
    margin-bottom: var(--space-1);
  }

  .status-value {
    font-size: var(--text-small);
    margin-bottom: 0;
  }
</style>
