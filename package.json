{
  "name": "realm",
  "description": "A monorepo for my personal apps consisting portfolio, tools, bot, etc",
  "author": "ahargunyllib",
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/vite": "^4.1.18",
      "@trpc/client": "^11.16.0",
      "@trpc/server": "^11.16.0",
      "tailwindcss": "^4.1.18",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.90.1",
      "hono": "^4.10.6",
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "typescript": "^5.9.3",
      "zod": "^4.3.6"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "alchemy": "catalog:",
    "lefthook": "^2.0.4",
    "typescript": "catalog:",
    "ultracite": "6.3.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm fix"
    ]
  },
  "scripts": {
    "check": "pnpm dlx ultracite check",
    "fix": "pnpm dlx ultracite fix",
    "typecheck": "pnpm --filter \"*\" typecheck",
    "test": "pnpm --filter \"*\" test",
    "dev:api": "pnpm --filter api dev"
  }
}
